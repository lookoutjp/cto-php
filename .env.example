APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

# マルチテナント: 既定サイトと、全サイト切替できる運営者の member_id（カンマ区切り）
APP_DEFAULT_SITE=www
APP_SUPER_ADMIN_MEMBER_IDS=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cto_php
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

# ローカルから Neon を検証するとき用（config の 'neon' 接続 / `php artisan db:neon-check`）
NEON_DATABASE_URL=
# 本番で Neon pooled(PgBouncer)経由のときは true（無いと SQLSTATE 25P02 で落ちる）
DB_EMULATE_PREPARES=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# ファイルライブラリの実体は S3/R2（下の AWS_* を設定）。未設定なら local。
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# 本番は resend（Resend）。ローカルで実送信しないなら log のまま。
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS="noreply@cto.jp"
MAIL_FROM_NAME="${APP_NAME}"

# ---- オブジェクトストレージ（Cloudflare R2 / AWS S3）----
# R2 の場合: REGION=auto, PATH_STYLE=true, ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3 の場合: REGION=ap-northeast-1 等, PATH_STYLE=false, ENDPOINT は空
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=cto-php
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# ---- 課金（Stripe / Cashier）----
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=jpy
CASHIER_CURRENCY_LOCALE=ja
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=
